# In .env.local kopieren und mit den echten Werten aus dem Supabase-Projekt
# (Project Settings -> API) befüllen. .env.local wird nicht committed.

# Öffentlich (im Browser sichtbar) - für den normalen Datenzugriff, abgesichert durch RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# NUR serverseitig (Route Handler /api/invite) - niemals mit NEXT_PUBLIC_ prefixen,
# niemals im Browser-Bundle landen lassen.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
